# OSAP API — sincronización INCREMENTAL del índice (IMSLP/OMR/Mutopia).
# Instalar en /etc/systemd/system/osap-index-sync.service y habilitar su timer:
#   sudo systemctl daemon-reload && sudo systemctl enable --now osap-index-sync.timer
#
# Usa el env legible por `ocw` del job semanal (mismas variables OSAP_INDEX_DB_*), para no
# ejecutar como root. El estado incremental vive en `sync_state` (osap-api).

[Unit]
Description=OSAP index incremental sync (OMR/CPDL/Mutopia)
After=network.target mysql.service osap-storage.service osap-api.service
Wants=osap-api.service osap-storage.service

[Service]
Type=oneshot
User=ocw
Group=ocw
WorkingDirectory=/home/ocw/openmusicrepository.com/osap-api
Environment=PYTHONPATH=/home/ocw/openmusicrepository.com/osap-api
EnvironmentFile=/etc/openmusicrepository/osap-weekly-novelties.env
ExecStart=/home/ocw/openmusicrepository.com/osap-api/.venv/bin/python script/sync_index.py --providers omr,cpdl,mutopia --db-host ${OSAP_INDEX_DB_HOST} --db-user ${OSAP_INDEX_DB_USER} --db-password ${OSAP_INDEX_DB_PASSWORD} --db-api ${OSAP_INDEX_DB_API} --db-omr ${OSAP_INDEX_DB_OMR} --omr-base-url https://storage.openmusicrepository.com
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
