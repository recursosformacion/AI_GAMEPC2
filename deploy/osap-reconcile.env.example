# OSAP API — variables de entorno del reconciliador de membresía (funnel 4.2).
# Copiar a `/home/ocw/openmusicrepository.com/osap-api/osap-reconcile.env` (NUNCA versionar
# credenciales reales) y ajustar. La unidad `osap-reconcile-membership.service` lo lee.

# Service client osap-api → osap-support (scope api:read, aud osap-support), creado en
# osap-auth con `python -m infrastructure.cli create-client --scopes=api:read --audiences=osap-support`.
OSAP_SUPPORT_CLIENT_ID=REEMPLAZAR
OSAP_SUPPORT_CLIENT_SECRET=REEMPLAZAR

# BD de osap-api (contadores/overrides/funnel_events).
OSAP_API_DB_USER=osap
OSAP_API_DB_PASSWORD=REEMPLAZAR
OSAP_API_DB_NAME=osap_api
