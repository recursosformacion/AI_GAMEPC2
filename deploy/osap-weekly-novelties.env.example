# OSAP API — variables de entorno de la rutina semanal de novedades.
# Crear como `/etc/openmusicrepository/osap-weekly-novelties.env` (legible por `ocw`, 640),
# NUNCA versionar credenciales reales. La unidad `osap-weekly-novelties.service`, que corre
# como ocw, lo lee (evita ejecutar la rutina como root).
#
# Credenciales del índice de osap-api (mismo usuario dedicado que el reindexado:
# `osap_indexer`, ver /etc/openmusicrepository/osap-index.env). Copiar aquí esos valores.
OSAP_INDEX_DB_HOST=127.0.0.1
OSAP_INDEX_DB_USER=osap_indexer
OSAP_INDEX_DB_PASSWORD=REEMPLAZAR
OSAP_INDEX_DB_API=osap_api
OSAP_INDEX_DB_OMR=osap_storage
