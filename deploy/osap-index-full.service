# OSAP API — reconstrucción COMPLETA del índice (con borrado previo).
# Necesaria para propagar BAJAS (el incremental no borra). Semanal.
# Instalar en /etc/systemd/system/osap-index-full.service y habilitar su timer:
#   sudo systemctl daemon-reload && sudo systemctl enable --now osap-index-full.timer

[Unit]
Description=OSAP index full rebuild (truncate + reindex)
After=network.target mysql.service osap-storage.service osap-api.service
Wants=osap-api.service osap-storage.service

[Service]
Type=oneshot
User=ocw
Group=ocw
WorkingDirectory=/home/ocw/openmusicrepository.com/osap-api
Environment=PYTHONPATH=/home/ocw/openmusicrepository.com/osap-api
EnvironmentFile=/etc/openmusicrepository/osap-weekly-novelties.env
ExecStart=/home/ocw/openmusicrepository.com/osap-api/.venv/bin/python script/rebuild_index.py --full --providers omr,cpdl --host ${OSAP_INDEX_DB_HOST} --user ${OSAP_INDEX_DB_USER} --password ${OSAP_INDEX_DB_PASSWORD} --database ${OSAP_INDEX_DB_API} --db-api ${OSAP_INDEX_DB_API} --db-omr ${OSAP_INDEX_DB_OMR}
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=6h

[Install]
WantedBy=multi-user.target
