# OSAP API — timer de la reconstrucción completa SEGURA del índice (domingos 03:30).
# Va antes del job semanal de novedades (lunes 04:30). Instalar en
# /etc/systemd/system/osap-index-full.timer y:
#   sudo systemctl daemon-reload && sudo systemctl enable --now osap-index-full.timer

[Unit]
Description=Run OSAP index full rebuild weekly (Sunday)

[Timer]
OnCalendar=Sun 03:30
AccuracySec=1min

[Install]
WantedBy=timers.target
