# Evitar cacheo de las páginas HTML mientras la app está en desarrollo activo.
# Los assets con hash (JS/CSS) sí se pueden cachear: cambian de nombre en cada build.
<IfModule mod_headers.c>
    <FilesMatch "\.(html)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# --- Modo mantenimiento (ADR-0037) -----------------------------------------
# Activar/desactivar con: web/scripts/maintenance.ps1 -On | -Off
# El equipo entra en revisión con: http://osap-app/?preview=<TOKEN>
# (el token lo imprime el script; queda en cookie osap_preview durante 1 día).
#
# OJO: no usar [L] para "saltar" mantenimiento en rutas de la SPA: el fallback de la SPA
# vive en el vhost, y un [L] aquí lo cortaría (404 en /viewer, etc.). El bypass se logra
# haciendo que la regla de 503 NO aplique cuando hay cookie.
ErrorDocument 503 /maintenance.html
RewriteEngine On

# Siempre accesibles: assets estáticos y la propia página de mantenimiento
RewriteCond %{REQUEST_URI} ^/(assets/|maintenance\.html$|favicon\.ico$|android-|apple-touch-|robots\.txt$|sitemap\.xml$) [NC]
RewriteRule ^ - [L]

# Con el flag activo y sin cookie de revisión, todo lo demás responde 503
RewriteCond %{HTTP_COOKIE} !osap_preview=1 [NC]
RewriteCond %{DOCUMENT_ROOT}/maintenance.flag -f
RewriteRule ^ - [R=503,L]

# Fallback SPA: al definir RewriteRule en .htaccess se reemplaza el del vhost, así que
# el fallback debe vivir aquí (si no, /viewer, /explore, etc. darían 404).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
