{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "osap-api",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "--factory",
        "src.osap.api.platform_app:create_platform_app",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
